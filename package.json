{
  "name": "farmy",
  "version": "1.9.0",
  "description": "Farmy – A lightweight overlay for League of Legends (Windows, Electron)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.4",
    "tesseract.js": "^5.1.1"
  },
  "license": "MIT",
  "productName": "Farmy",
  "author": "Jamy Haas",
  "build": {
    "appId": "com.jamyh.allyouneed",
    "productName": "Farmy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "config.example.json",
      "src/**",
      "renderer/**",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json",
      "node_modules/**",
      "!node_modules/tesseract.js-core/*.wasm.js"
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "legalTrademarks": "Farmy"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Farmy",
      "runAfterFinish": true,
      "uninstallDisplayName": "Farmy",
      "artifactName": "Farmy-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Farmy-${version}-portable.exe"
    },
    "copyright": "Copyright © 2026 Jamy Haas",
    "publish": [
      {
        "provider": "github",
        "owner": "JamyH",
        "repo": "farmy"
      }
    ]
  }
}
