{
  "name": "all-you-need",
  "version": "1.4.0",
  "description": "All You Need – A lightweight overlay for League of Legends (Windows, Electron)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "koffi": "^3.3.4",
    "tesseract.js": "^5.1.1"
  },
  "license": "MIT",
  "productName": "All You Need",
  "author": "Jamy Haas",
  "build": {
    "appId": "com.jamyh.allyouneed",
    "productName": "All You Need",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-capture.js",
      "config.example.json",
      "src/**",
      "renderer/**",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json",
      "node_modules/**"
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "legalTrademarks": "All You Need"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "All You Need",
      "runAfterFinish": true,
      "uninstallDisplayName": "All You Need",
      "artifactName": "All-You-Need-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "All-You-Need-${version}-portable.exe"
    },
    "copyright": "Copyright © 2026 Jamy Haas"
  }
}
